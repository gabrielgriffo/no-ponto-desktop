{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "No Ponto",
  "version": "0.1.0",
  "identifier": "com.gabrielgriffo.noponto",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/noponto-controle-ponto/browser"
  },
  "app": {
    "windows": [
      {
        "title": "No Ponto",
        "width": 393,
        "height": 506,
        "decorations": false,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Gabriel Griffo",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": ["gnome-keyring"]
      },
      "rpm": {
        "depends": ["gnome-keyring"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMUMwMUNEM0I2OEEyRjYKUldUMm9tZzd6UUVjUGNsUGdKM0tTMUxDUVlTZi80YnhPdm1tbkF6K0JXYll2cFNPZFYwMFJQbVAK",
      "endpoints": [
        "https://github.com/gabrielgriffo/noponto-controle-pontomais/releases/latest/download/latest.json"
      ]
    }
  }
}
